# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/media_sentiment?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://your_user:your_password@cluster0.mongodb.net/media_sentiment?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Google Cloud YouTube Data API v3 Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google Gemini API Key (From Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Scrape.do Proxy API Token (Optional: for experimental Flipkart review fetching)
# Sign up at https://scrape.do to obtain a token with residential proxy rotation
SCRAPEDO_TOKEN=your_scraped_do_token_here

# Client URL (for CORS allowance)
CLIENT_URL=http://localhost:5173

