# =================================================================
# MediaSentiment — Environment Configuration Template (.env.example)
# =================================================================
# Copy this file to `server/.env` (and adjust `client/.env` if needed).
# Replace all placeholder values with your real configuration.
# NEVER commit files containing actual secrets or passwords to Git.
# =================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas Cluster or Local Instance)
# Format: mongodb+srv://<username>:<password>@<cluster-hostname>/media_sentiment?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://your_database_user:your_password@cluster0.mongodb.net/media_sentiment?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Google Cloud YouTube Data API v3 Key (Optional if using Python downloader engine)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google Gemini API Key (From Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Scrape.do Proxy API Token (Optional: for experimental Flipkart review fetching)
# Sign up at https://scrape.do to obtain a token with residential proxy rotation
SCRAPEDO_TOKEN=your_scraped_do_token_here

# CORS Configuration — Frontend Client Origin
CLIENT_URL=http://localhost:5173

